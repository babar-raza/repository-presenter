{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/repository-presenter/schemas/candidate-bundle.schema.json",
  "title": "Sealed candidate bundle manifest",
  "description": "Shape of candidates/<owner>__<name>/<revision>/manifest.json, the seal of one README transaction. The bundle is content-addressed evidence: every file it lists is hashed here, and this manifest is the only record that status counts from. A bundle is sealed at ACCEPTED and may reach READY_FOR_PROPOSAL only with a recorded fresh-process, byte-identical, zero-provider-call no-op proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "revision",
    "state",
    "sealed_at",
    "files",
    "provider_calls",
    "no_op_proof"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "state": {
      "enum": [
        "ACCEPTED",
        "PROVING_NO_OP",
        "READY_FOR_PROPOSAL",
        "VALID_UPDATE_AVAILABLE",
        "INVALIDATED",
        "SUPERSEDED"
      ]
    },
    "sealed_at": { "$ref": "#/$defs/timestamp" },
    "files": {
      "type": "object",
      "required": [
        "README.md",
        "README.patch",
        "facts.json",
        "dispositions.json",
        "plan.json",
        "validation.json",
        "review.json",
        "calls.jsonl",
        "dependencies.json"
      ],
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
      "additionalProperties": { "$ref": "#/$defs/file_digest" }
    },
    "provider_calls": { "type": "integer", "minimum": 0 },
    "models_used": {
      "type": "object",
      "description": "route -> the model this run answered it with (core/llm/fallback.py); a consumed input, so a change is a recorded update scoped by the prompts that route answers.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "classification", "earliest_affected_stage", "changed", "transaction", "recorded_at"],
      "properties": {
        "available": { "const": true },
        "classification": { "enum": ["presentation", "factual"] },
        "scopes": {
          "type": "array",
          "description": "Every invalidation scope whose consumed input changed, in stage order (components/readme/bundle/invalidation.py).",
          "items": { "enum": ["facts", "evidence", "reconciliation", "presentation", "planning", "authoring", "validator", "reviewer"] }
        },
        "triggering_scope": {
          "enum": ["facts", "evidence", "reconciliation", "presentation", "planning", "authoring", "validator", "reviewer"],
          "description": "The scope that decided the state: the facts scope (INVALIDATED) when it changed, else the earliest."
        },
        "scope_basis": {
          "enum": ["inputs", "artifacts"],
          "description": "inputs: computed from the changed dependencies; artifacts: a rerun's bytes moved with no consumed input changed."
        },
        "earliest_affected_stage": { "type": ["string", "null"] },
        "changed": { "type": "array", "items": { "type": "string" } },
        "transaction": { "type": "string" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "models_used": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adopted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "earliest_affected_stage", "changed", "recorded_at", "previous_proof", "adopted_at"],
      "properties": {
        "classification": { "enum": ["presentation", "factual"] },
        "scopes": { "type": "array", "items": { "enum": ["facts", "evidence", "reconciliation", "presentation", "planning", "authoring", "validator", "reviewer"] } },
        "triggering_scope": { "enum": ["facts", "evidence", "reconciliation", "presentation", "planning", "authoring", "validator", "reviewer"] },
        "scope_basis": { "enum": ["inputs", "artifacts"] },
        "earliest_affected_stage": { "type": ["string", "null"] },
        "changed": { "type": "array", "items": { "type": "string" } },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "previous_proof": { "type": ["object", "null"] },
        "previous_models_used": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "adopted_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "superseded_by": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "invalidated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "causal_stage", "detail", "recorded_at"],
      "properties": {
        "check": { "type": ["string", "null"], "description": "The failing blocking check; null when a changed factual input (the facts scope) invalidated the candidate." },
        "scope": { "enum": ["facts", "evidence", "reconciliation", "presentation", "planning", "authoring", "validator", "reviewer"], "description": "The invalidation scope that triggered it, when a changed input did." },
        "causal_stage": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "call_variance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job", "distinct_responses", "response_sha256s"],
        "properties": {
          "job": { "type": "string" },
          "distinct_responses": { "type": "integer", "minimum": 2 },
          "response_sha256s": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisories", "coverage_advisories", "blocking_failures"],
      "properties": {
        "review_verdict": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "review_verdict_as_returned": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "advisories": { "type": "integer", "minimum": 0 },
        "coverage_advisories": { "type": "integer", "minimum": 0 },
        "blocking_failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "no_op_proof": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["proven_at", "fresh_process", "byte_identical", "provider_calls"],
          "properties": {
            "proven_at": { "$ref": "#/$defs/timestamp" },
            "fresh_process": { "const": true },
            "byte_identical": { "const": true },
            "provider_calls": { "const": 0 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "READY_FOR_PROPOSAL" } } },
      "then": { "properties": { "no_op_proof": { "type": "object" } } }
    },
    {
      "if": { "properties": { "state": { "const": "VALID_UPDATE_AVAILABLE" } } },
      "then": {
        "required": ["update"],
        "properties": { "no_op_proof": { "type": "object" } }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "file_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
