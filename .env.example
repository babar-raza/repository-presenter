# Copy to .env and fill in. .env is gitignored; credentials never enter the repository.
# From G1 onward the official entry point refuses to run a transaction without these.

# OpenAI-compatible chat-completions gateway for the configurable custom LLM.
LLM_BASE_URL=https://gateway.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Repository-scoped, read-only GitHub token for analysis. Write credentials never live here.
GH_TOKEN=
