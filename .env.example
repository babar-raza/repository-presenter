# Process environment variables, not a file to copy: this project reads credentials from the
# environment it runs in and does not read or require a .env file for them (RESEARCH_AND_GUIDELINES.md
# section 18.4). This file documents the names only. If .env is used anyway it stays gitignored.
# From G1 onward the official entry point refuses to run a transaction without these.

# OpenAI-compatible chat-completions gateway for the configurable custom LLM. The gateway serves
# several models; each prompt manifest names the one it routes to, chosen from what preflight
# discovers. GPT_OSS_MODEL overrides a manifest's default route for local experimentation only.
GPT_OSS_ENDPOINT=
GPT_OSS_API_KEY=
GPT_OSS_MODEL=

# Repository-scoped, read-only GitHub token for analysis. Write credentials never live here.
GH_TOKEN=

# `metadata --apply`'s gated write path only (components/metadata/apply.py) - both unset by
# default, and unset in this project's own environment today. GH_METADATA_WRITE_TOKEN is a
# separate, write-scoped token, deliberately never GH_TOKEN (RESEARCH_AND_GUIDELINES.md;
# AGENTS.md "Write credentials exist only in a separate effect job"). Setting the token alone does
# NOT enable a write: REPOSITORY_PRESENTER_METADATA_WRITE_AUTHORIZED must also be "1", the owner's
# own explicit go-ahead, never inferred from the token's presence or scope.
GH_METADATA_WRITE_TOKEN=
REPOSITORY_PRESENTER_METADATA_WRITE_AUTHORIZED=

# `file-upstream-defects --file`'s gated write path only (components/issues/file.py) - both unset
# by default, and unset in this project's own environment today. GH_ISSUES_WRITE_TOKEN is a
# separate, Issues:Write-scoped token, deliberately never GH_TOKEN (RESEARCH_AND_GUIDELINES.md;
# AGENTS.md "Write credentials exist only in a separate effect job"). Setting the token alone does
# NOT enable a write: REPOSITORY_PRESENTER_ISSUES_WRITE_AUTHORIZED must also be "1", the owner's
# own explicit go-ahead, never inferred from the token's presence or scope.
GH_ISSUES_WRITE_TOKEN=
REPOSITORY_PRESENTER_ISSUES_WRITE_AUTHORIZED=

# `propose`'s gated write path only (components/propose/effect.py, G6-W02) - both unset by default,
# and unset in this project's own environment today. GH_PROPOSAL_WRITE_TOKEN is a separate,
# repository-scoped Contents:Write/Pull-requests:Write token, minted fresh inside propose.yml's own
# effect job only, deliberately never GH_TOKEN and never GH_METADATA_WRITE_TOKEN/
# GH_ISSUES_WRITE_TOKEN either (RESEARCH_AND_GUIDELINES.md; AGENTS.md "Write credentials exist only
# in a separate effect job"). Setting the token alone does NOT enable a write:
# REPOSITORY_PRESENTER_PROPOSAL_WRITE_AUTHORIZED must also be "1", the owner's own explicit
# go-ahead, never inferred from the token's presence or scope.
GH_PROPOSAL_WRITE_TOKEN=
REPOSITORY_PRESENTER_PROPOSAL_WRITE_AUTHORIZED=
