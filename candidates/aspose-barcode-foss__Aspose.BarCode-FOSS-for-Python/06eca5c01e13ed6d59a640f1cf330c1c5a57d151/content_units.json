      ],
      "section": "key_capabilities",
      "slot": "capability:4",
      "text": "Tune symbology-specific settings like error correction level and encoding mode for qr codes, or options such as adding a check digit for code39, by providing QrErrorCorrectionLevel, Code128EncodeMode, or Code39Options during construction."
    },
