      "section": "scope_limitations",
      "slot": "scope",
      "text": "Aspose.BarCode FOSS for Python creates barcodes for all supported symbologies using the member AUTO or member H encoding modes, and exports them as PNG or SVG images via the member to_png or member to_svg methods."
    },
    {
      "fact_ids": [
        "inherited_unit:052.list",
        "install_command:pip"
      ],
      "section": "scope_limitations",
      "slot": "limitation:1",
      "text": "The library does not read or decode existing barcode images for any symbology."
    },
    {
      "fact_ids": [
        "inherited_unit:052.list"
      ],
      "section": "scope_limitations",
      "slot": "limitation:2",
      "text": "PDF rendering is not implemented — calling member render with PDF output or using member to_pdf raises NotImplementedError."
    },
    {
      "fact_ids": [
        "inherited_unit:052.list"
      ],
      "section": "scope_limitations",
      "slot": "limitation:3",
      "text": "ECI (Extended Channel Interpretation) normalization and validation are not implemented despite EncodeOptions exposing an eci_assignment_number field on every symbology's options type."
    },
    {
      "fact_ids": [
        "inherited_unit:052.list"
      ],
      "section": "scope_limitations",
      "slot": "limitation:4",
      "text": "GS1 data parsing and validation are not implemented despite EncodeOptions exposing a gs1_enabled field on every symbology's options type."
    },
