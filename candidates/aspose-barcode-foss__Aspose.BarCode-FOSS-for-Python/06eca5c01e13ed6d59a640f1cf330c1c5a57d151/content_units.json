        "public_symbol:aspose_barcode_foss.qroptions"
      ],
      "section": "key_capabilities",
      "slot": "capability:2",
      "text": "Generate QR Code (Model 2) barcodes spanning versions 1-40 with configurable error correction level and encoding mode through the QrOptions class."
    },
    {
      "fact_ids": [
