      "slot": "limitation:1",
      "text": "PDF rendering is not implemented — aspose_barcode_foss.Barcode.to_pdf and aspose_barcode_foss.PdfRenderer.render both raise NotImplementedError."
    },
    {
      "fact_ids": [
        "identity:family",
        "inherited_unit:052.list"
      ],
      "section": "scope_limitations",
      "slot": "limitation:2",
      "text": "This library only generates barcodes and does not read or decode existing barcode images for any symbology."
    },
