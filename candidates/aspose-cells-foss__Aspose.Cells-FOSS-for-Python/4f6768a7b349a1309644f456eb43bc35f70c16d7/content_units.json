        "example:002",
        "public_symbol:aspose.cells_foss.cells",
        "public_symbol:aspose.cells_foss.workbook",
        "public_symbol:aspose.cells_foss.worksheet"
      ],
      "section": "key_capabilities",
      "slot": "capability:1",
      "text": "Create new workbooks from scratch or load existing Excel files, then read or write cell values using the Cells collection on a Worksheet obtained by index, name, or active sheet."
    },
