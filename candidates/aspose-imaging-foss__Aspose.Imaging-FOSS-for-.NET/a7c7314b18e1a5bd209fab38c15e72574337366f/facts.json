      "kind": "inherited_unit",
      "polarity": "SUPPORTED",
      "value": "## Supported formats"
    },
    {
      "attributes": {
        "section": "Aspose.Imaging FOSS for .NET > Supported formats"
      },
      "confidence": 1.0,
      "evidence": [
        {
          "detail": "lines 29-44; table; under Aspose.Imaging FOSS for .NET > Supported formats",
