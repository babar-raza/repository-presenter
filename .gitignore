# Disposable runtime state (work clones, caches, mutable run output) -- never durable authority
/runs/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
.venv/
venv/
# scripts/ci_check.sh's isolated tools venv (uv, pip-audit) and its SBOM/audit outputs
/.venv-ci-tools/

# Secrets and local overrides -- credentials never enter the repository
.env
.env.*
!.env.example
.secrets

# Editors and local agent state
.vscode/
.idea/
/.claude/settings.local.json
/.claude/worktrees/

# Owner/reviewer tooling state - machine-local, never portfolio content (docs/REPOSITORY_LAYOUT.md)
tools/reviewer/.local/
tools/census/.local/
tools/discovery/.local/
